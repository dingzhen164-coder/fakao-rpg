                "target": "peer_review_practice"
              }
            ]
          },
          "peer_review_method": {
            "lines": [
              "诺亚在灯下留出一张空白书签：“先说出答案，再翻看背面，按真实表现评分。”"
            ],
            "choices": [
              {
                "id": "continue",
                "text": "记下这个方向",
                "target": "peer_review_end"
              }
            ]
          },
          "peer_review_practice": {
            "lines": [
              "诺亚指向试炼塔：“复练保留原规则，弄清判断依据比多点一次领奖更有用。”"
            ],
            "choices": [
              {
